modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "reserved"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
IMPORT_HISTORICAL_LOGS = "false"
INVITE_LOG_CHANNEL_ID = "1523461851336278076"
SERVER_LABEL = "Noomspace"
RUN_BOT_TEST = "false"
